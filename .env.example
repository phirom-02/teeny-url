# Copy to .env and adjust as needed: cp .env.example .env

# Postgres (used by docker-compose.yml)
POSTGRES_USER=teeny
POSTGRES_PASSWORD=teeny
POSTGRES_DB=teeny_url
POSTGRES_PORT=5432

# API
DATABASE_URL=postgres://teeny:teeny@localhost:5432/teeny_url
APP_PORT=3000
# Public origin used to build short URLs (no trailing slash)
BASE_URL=http://localhost:8080
NODE_ENV=development
LOG_LEVEL=info
