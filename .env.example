# Copy to .env and adjust as needed: cp .env.example .env

# Postgres (used by docker-compose.yml)
POSTGRES_USER=teeny
POSTGRES_PASSWORD=teeny
POSTGRES_DB=teeny_url
POSTGRES_PORT=5432

# API
DATABASE_URL=postgres://teeny:teeny@localhost:5432/teeny_url
PORT=3000
# Public origin used to build short URLs (no trailing slash)
BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Web UI (web/, SvelteKit)
# Mount the built UI (web/build, from `pnpm build`) in `pnpm start`. Default true; false serves
# the API only. `pnpm dev` always sets it to false (Vite serves the UI on :5173). true/false/1/0.
# SERVE_UI=true
# Optional: where the UI's server-side code reaches the API. Leave unset —
# `pnpm start` uses http://127.0.0.1:$PORT and `pnpm dev` uses http://localhost:3000
# (if you change PORT, set this to http://localhost:<PORT> for `pnpm dev`).
# API_ORIGIN=http://localhost:3000
